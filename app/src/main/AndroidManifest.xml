<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<uses-permission android:name="android.permission.CAMERA"/>
<uses-permission android:name="android.permission.INTERNET"/>
<uses-feature
    android:name ="android.hardware.camera"
    android:required="false"/>
    <application
        android:name=".app.MyApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SdkStudyDemo">
        <activity
            android:name=".ui.eventmonitor.EventMonitorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.setting.SettingActivity"/>
        <activity
            android:name=".ui.day48.Day48Activity"
            android:exported="true"
            android:label="Day 48 生命周期 Demo" />
        <activity
            android:name=".ui.day49.Day49Activity"
            android:exported="true"
            android:label="Day 49 Fragment Demo" />
        <activity
            android:name=".ui.day50.Day50Activity"
            android:exported="true"
            android:label="Day 50 Service 生命周期实验室" />
        <activity
            android:name=".ui.day51.Day51Activity"
            android:exported="true"
            android:label="Day 51 BroadcastReceiver 与 WorkManager 实验室" />

        <!--
          Day51StaticReceiver 为 ADB 进程唤起实验开放，但要求发送方持有系统签名级 DUMP 权限。
          adb shell 具备该权限，普通第三方 App 不具备，避免为了 Demo 无限制暴露 Receiver。
        -->
        <receiver
            android:name=".ui.day51.Day51StaticReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.sdkstudydemo.DAY51_STATIC" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ui.day51.Day51UnsafeReceiver"
            android:exported="false" />

        <receiver
            android:name=".ui.day51.Day51WorkEnqueueReceiver"
            android:exported="false" />
        <service android:name=".service.DemoService"
            android:exported="false"/>
        <service android:name=".service.DemoBoundService"
            android:exported="false"/>
        <service
            android:name=".ui.day50.Day50DemoService"
            android:exported="false" />


        <provider
            android:authorities="com.example.sdkstudydemo.demo.provider"
            android:name=".provider.DemoContentProvider"
            android:exported="false"/>
    </application>

</manifest>
