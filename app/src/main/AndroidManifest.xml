<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<uses-permission android:name="android.permission.CAMERA"/>
<uses-permission android:name="android.permission.INTERNET"/>
<uses-feature
    android:name ="android.hardware.camera"
    android:required="false"/>
    <application
        android:name=".app.MyApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SdkStudyDemo">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.setting.SettingActivity"/>
        <activity
            android:name=".ui.day48.Day48Activity"
            android:exported="true"
            android:label="Day 48 生命周期 Demo" />
        <activity
            android:name=".ui.day49.Day49Activity"
            android:exported="true"
            android:label="Day 49 Fragment Demo" />
        <activity
            android:name=".ui.day50.Day50Activity"
            android:exported="true"
            android:label="Day 50 Service 生命周期实验室" />
        <service android:name=".service.DemoService"
            android:exported="false"/>
        <service android:name=".service.DemoBoundService"
            android:exported="false"/>
        <service
            android:name=".ui.day50.Day50DemoService"
            android:exported="false" />


        <provider
            android:authorities="com.example.sdkstudydemo.demo.provider"
            android:name=".provider.DemoContentProvider"
            android:exported="false"/>
    </application>

</manifest>
