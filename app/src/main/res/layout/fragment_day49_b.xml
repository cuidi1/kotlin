<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fragment B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDay49BCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前共享 count：0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnDay49BIncrease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="共享 count +1"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDay49SelectCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择成都并返回 A"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDay49OnlyPop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="仅 popBackStack 返回"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvDay49BDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="“选择成都并返回 A”会先 setFragmentResult() 发送数据，再 popBackStack() 返回。\n\n“仅 popBackStack 返回”不会发送任何新数据。"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
