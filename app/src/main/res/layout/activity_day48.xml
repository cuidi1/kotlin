<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Day 48：生命周期综合 Demo"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDay48ProcessInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDay48ActivityInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnDay48Recreate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="recreate Activity" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/day48FragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="手机端 Fragment 生命周期日志"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDay48ClearLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清空页面日志" />

    <ScrollView
        android:id="@+id/day48LifecycleLogScrollView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#EEEEEE"
        android:fillViewport="true"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvDay48LifecycleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />

    </ScrollView>

</LinearLayout>
